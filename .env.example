# ==============================================================================
# UZHAVAN AI - AUTONOMOUS MULTILINGUAL FARMER VOICE COMMUNICATION SYSTEM CONFIG
# ==============================================================================

# Application Settings
APP_NAME="Uzhavan AI - Autonomous Voice Portal"
APP_ENV=development
SECRET_KEY=uzhavan_ai_voice_secure_key_2026
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Base URL for Webhooks (Public URL or local tunnel URL, e.g. https://xyz.ngrok.app)
BASE_WEBHOOK_URL=http://localhost:8000

# Database (SQLite default for seamless local dev; can use postgresql+asyncpg://...)
DATABASE_URL=sqlite+aiosqlite:///./uzhavan_voice.db
DATABASE_SYNC_URL=sqlite:///./uzhavan_voice.db

# Live Uzhavan AI API Integration
UZHAVAN_LIVE_API_BASE=https://uzhavan-ai.duckdns.org

# Firebase Backend Integration (Uzhavan AI Mobile App)
FIREBASE_PROJECT_ID=uzhavan-ai-686d6
FIREBASE_API_KEY=AIzaSyDvfHQ3bAFbe2kvkkEQOkKeU0kgZcTZIH4
FIREBASE_AUTH_DOMAIN=uzhavan-ai-686d6.firebaseapp.com
FIREBASE_STORAGE_BUCKET=uzhavan-ai-686d6.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SYNC_INTERVAL_MINUTES=15
FIREBASE_SYNC_ON_STARTUP=True

# Weather Provider Settings
WEATHER_PROVIDER=open-meteo # open-meteo, uzhavan-live, openweather
OPENWEATHER_API_KEY=

# Telephony Configuration (exotel, twilio, simulation)
TELEPHONY_PROVIDER=simulation # Set to 'exotel' or 'twilio' for live PSTN calls
TELEPHONY_CONCURRENCY_LIMIT=10

# Exotel Telephony Credentials (for live Indian voice calling)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com

# Twilio Telephony Credentials (alternative provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Text-to-Speech (TTS) Engine
TTS_PROVIDER=uzhavan-live # uzhavan-live, gcp, edge
GOOGLE_APPLICATION_CREDENTIALS=

# Background Queue & Celery
REDIS_URL=redis://localhost:6379/0
USE_CELERY=False # Set to True when Redis server is active, otherwise uses internal Async Queue

# Call Policy & Retry System
MAX_RETRIES=3
RETRY_DELAY_MINUTES=30
QUIET_HOURS_START=21 # 9:00 PM (21:00)
QUIET_HOURS_END=6    # 6:00 AM (06:00)
EMERGENCY_OVERRIDE_QUIET_HOURS=True

# Autonomous Monitor Intervals (in minutes)
WEATHER_CHECK_INTERVAL_MINUTES=30
MARKET_CHECK_INTERVAL_MINUTES=60
SCHEME_CHECK_INTERVAL_MINUTES=120
NEWS_CHECK_INTERVAL_MINUTES=60
